 @dataclass(frozen=True)
@@ -25,3 +26,14 @@ class Recipe:
 
     def shopping_list(self) -> list[str]:
         return [ingredient.describe() for ingredient in self.ingredients]
+
+    def scaled(self, servings: int) -> Self:
+        """A copy of the recipe for `servings` people, with every quantity scaled to match."""
+        if servings < 1:
+            raise ValueError("a recipe serves at least one person")
+        factor = servings / self.servings
+        ingredients = tuple(
+            replace(ingredient, quantity=ingredient.quantity * factor)
+            for ingredient in self.ingredients
+        )
+        return replace(self, servings=servings, ingredients=ingredients)
